{
  "version": 1,
  "name": "Tick",
  "group": "Tick",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 3,
        "hold_ms": {
          "ref": "inputs.hold"
        },
        "decay_ms": 10,
        "attack_curve": "linear",
        "decay_curve": -3
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "cutoff_hz": {
          "ref": "inputs.tone_cutoff"
        },
        "resonance": 0.707,
        "amount": 0
      }
    },
    "n4": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": 0.1
      }
    },
    "n5": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n4.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    },
    "n6": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 1,
        "hold_ms": 0,
        "decay_ms": 10,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n7": {
      "module": "noise",
      "inputs": {
        "seed": 1
      }
    },
    "n8": {
      "module": "lowpass",
      "inputs": {
        "audio": {
          "ref": "n7.audio"
        },
        "envelope": {
          "ref": "n6.control"
        },
        "cutoff_hz": 3000,
        "resonance": 0.707,
        "amount": 0
      }
    },
    "n9": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n8.audio"
        },
        "envelope": {
          "ref": "n6.control"
        },
        "gain": {
          "ref": "inputs.click"
        }
      }
    },
    "n10": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n9.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n6.duration_ms"
        }
      }
    },
    "n11": {
      "module": "mix",
      "inputs": {
        "audio_a": {
          "ref": "n5.audio"
        },
        "audio_b": {
          "ref": "n10.audio"
        },
        "duration_a_ms": {
          "ref": "n5.end_ms"
        },
        "duration_b_ms": {
          "ref": "n10.end_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n11.audio"
    },
    "duration_ms": {
      "ref": "n11.duration_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "D7",
      "range": [
        "C4",
        "C8"
      ]
    },
    "click": {
      "label": "Click",
      "type": "float",
      "default": 0.05,
      "range": [
        0,
        0.2
      ],
      "step": 0.01
    },
    "hold": {
      "label": "Hold",
      "type": "duration",
      "default": 5,
      "unit": "ms",
      "range": [
        5,
        40
      ],
      "step": 5
    },
    "tone_cutoff": {
      "label": "Tone cutoff",
      "type": "float",
      "default": 2200,
      "unit": "Hz",
      "range": [
        100,
        6000
      ],
      "step": 100
    }
  }
}
