{
  "version": 1,
  "name": "dir-change",
  "group": "Commando",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_ahd",
      "inputs": {
        "attack_ms": 5,
        "hold_ms": 0,
        "decay_ms": 30,
        "attack_curve": "linear",
        "decay_curve": "linear"
      }
    },
    "n1": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n2": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n1.hz"
        },
        "phase_cycles": 0
      }
    },
    "n3": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n2.audio"
        },
        "envelope": {
          "ref": "n0.control"
        },
        "gain": {
          "ref": "inputs.level"
        }
      }
    },
    "n4": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n3.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n0.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n4.audio"
    },
    "duration_ms": {
      "ref": "n4.end_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "C5",
      "range": [
        "C4",
        "C6"
      ]
    },
    "level": {
      "label": "Level",
      "type": "float",
      "default": 0.3,
      "range": [
        0.1,
        0.4
      ],
      "step": 0.05
    }
  }
}
