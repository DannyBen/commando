{
  "version": 1,
  "name": "message-success",
  "group": "Commando",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 2,
        "level": 0.82,
        "curve": "linear"
      }
    },
    "n1": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n0.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 0.0027,
        "curve": -5
      }
    },
    "n2": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n1.shape"
        },
        "duration_ms": 1,
        "level": 0,
        "curve": "linear"
      }
    },
    "n3": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n2.shape"
        }
      }
    },
    "n4": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note_1"
        }
      }
    },
    "n5": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.waveform"
        },
        "match": "square",
        "if_true": "square",
        "if_false": "saw"
      }
    },
    "n6": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.waveform"
        },
        "match": "triangle",
        "if_true": "triangle",
        "if_false": {
          "ref": "n5.value"
        }
      }
    },
    "n7": {
      "module": "text_select",
      "inputs": {
        "selector": {
          "ref": "inputs.waveform"
        },
        "match": "sine",
        "if_true": "sine",
        "if_false": {
          "ref": "n6.value"
        }
      }
    },
    "n8": {
      "module": "oscillator",
      "inputs": {
        "waveform": {
          "ref": "n7.value"
        },
        "frequency_hz": {
          "ref": "n4.hz"
        },
        "phase_cycles": 0
      }
    },
    "n9": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n8.audio"
        },
        "envelope": {
          "ref": "n3.control"
        },
        "gain": {
          "ref": "inputs.level"
        }
      }
    },
    "n10": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n9.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n3.duration_ms"
        }
      }
    },
    "n11": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": 2,
        "level": 0.82,
        "curve": "linear"
      }
    },
    "n12": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n11.shape"
        },
        "duration_ms": {
          "ref": "inputs.body"
        },
        "level": 0.0027,
        "curve": -5
      }
    },
    "n13": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n12.shape"
        },
        "duration_ms": 1,
        "level": 0,
        "curve": "linear"
      }
    },
    "n14": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n13.shape"
        }
      }
    },
    "n15": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note_2"
        }
      }
    },
    "n16": {
      "module": "oscillator",
      "inputs": {
        "waveform": {
          "ref": "n7.value"
        },
        "frequency_hz": {
          "ref": "n15.hz"
        },
        "phase_cycles": 0
      }
    },
    "n17": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n16.audio"
        },
        "envelope": {
          "ref": "n14.control"
        },
        "gain": {
          "ref": "inputs.level"
        }
      }
    },
    "n18": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n17.audio"
        },
        "start_ms": {
          "ref": "inputs.spacing"
        },
        "duration_ms": {
          "ref": "n14.duration_ms"
        }
      }
    },
    "n19": {
      "module": "mix",
      "inputs": {
        "audio_a": {
          "ref": "n10.audio"
        },
        "audio_b": {
          "ref": "n18.audio"
        },
        "duration_a_ms": {
          "ref": "n10.end_ms"
        },
        "duration_b_ms": {
          "ref": "n18.end_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n19.audio"
    },
    "duration_ms": {
      "ref": "n19.duration_ms"
    }
  },
  "inputs": {
    "note_1": {
      "label": "Note 1",
      "type": "note",
      "default": "E5",
      "range": [
        "C2",
        "C8"
      ]
    },
    "note_2": {
      "label": "Note 2",
      "type": "note",
      "default": "A5",
      "range": [
        "C2",
        "C8"
      ]
    },
    "waveform": {
      "label": "Waveform",
      "type": "choice",
      "default": "triangle",
      "choices": [
        "sine",
        "triangle",
        "square",
        "saw"
      ]
    },
    "level": {
      "label": "Level",
      "type": "float",
      "default": 0.4,
      "range": [
        0,
        1
      ],
      "step": 0.01
    },
    "body": {
      "label": "Decay duration",
      "type": "duration",
      "default": 55,
      "unit": "ms",
      "range": [
        1,
        300
      ],
      "step": 1
    },
    "spacing": {
      "label": "Spacing",
      "type": "duration",
      "default": 50,
      "unit": "ms",
      "range": [
        0,
        300
      ],
      "step": 1
    }
  }
}
