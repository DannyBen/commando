{
  "version": 1,
  "name": "click",
  "group": "sounds",
  "render": {
    "sample_rate": 48000,
    "channels": 1
  },
  "graph": {
    "n0": {
      "module": "envelope_segment",
      "inputs": {
        "duration_ms": {
          "ref": "inputs.attack"
        },
        "level": 1,
        "curve": "linear"
      }
    },
    "n1": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n0.shape"
        },
        "duration_ms": {
          "ref": "inputs.decay"
        },
        "level": 0,
        "curve": "linear"
      }
    },
    "n2": {
      "module": "envelope_segment",
      "inputs": {
        "previous": {
          "ref": "n1.shape"
        },
        "duration_ms": 1,
        "level": 0,
        "curve": "linear"
      }
    },
    "n3": {
      "module": "envelope_segments",
      "inputs": {
        "segments": {
          "ref": "n2.shape"
        }
      }
    },
    "n4": {
      "module": "note_frequency",
      "inputs": {
        "note": {
          "ref": "inputs.note"
        }
      }
    },
    "n5": {
      "module": "oscillator",
      "inputs": {
        "waveform": "sine",
        "frequency_hz": {
          "ref": "n4.hz"
        },
        "phase_cycles": 0
      }
    },
    "n6": {
      "module": "amplifier",
      "inputs": {
        "audio": {
          "ref": "n5.audio"
        },
        "envelope": {
          "ref": "n3.control"
        },
        "gain": {
          "ref": "inputs.level"
        }
      }
    },
    "n7": {
      "module": "place",
      "inputs": {
        "audio": {
          "ref": "n6.audio"
        },
        "start_ms": 0,
        "duration_ms": {
          "ref": "n3.duration_ms"
        }
      }
    }
  },
  "output": {
    "audio": {
      "ref": "n7.audio"
    },
    "duration_ms": {
      "ref": "n7.end_ms"
    }
  },
  "inputs": {
    "note": {
      "label": "Note",
      "type": "note",
      "default": "A3",
      "range": [
        "C2",
        "C8"
      ]
    },
    "attack": {
      "label": "Attack",
      "type": "duration",
      "default": 2,
      "unit": "ms",
      "range": [
        0,
        10
      ],
      "step": 1
    },
    "decay": {
      "label": "Decay",
      "type": "duration",
      "default": 10,
      "unit": "ms",
      "range": [
        1,
        100
      ],
      "step": 1
    },
    "level": {
      "label": "Level",
      "type": "float",
      "default": 0.1,
      "range": [
        0,
        1
      ],
      "step": 0.01
    }
  }
}
